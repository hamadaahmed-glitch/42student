# ==============================================================================
# 42 STUDENT OS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values.
# ==============================================================================

# Gemini AI Authentication
GEMINI_API_KEY="your-gemini-api-key-here"

# Model Selection
# Recommended: gemini-2.5-pro for deep debugging & project analysis
#              gemini-2.5-flash for rapid linting, quiz, and hint escalation
GEMINI_PRIMARY_MODEL="gemini-2.5-pro"
GEMINI_FAST_MODEL="gemini-2.5-flash"

# Application Environment (development | production | testing)
APP_ENV="development"
LOG_LEVEL="INFO"

# Workspace & Storage Paths
# If left blank, these will default to ~/.42student/
STUDENT42_HOME=""
STUDENT42_WORKSPACE_DIR=""

# Toolchain Defaults
CC="gcc"
CFLAGS="-Wall -Wextra -Werror"
NORMINETTE_BIN="norminette"
VALGRIND_BIN="valgrind"

# Gamification & Session Defaults
DAILY_XP_TARGET=500
STREAK_GRACE_HOURS=24